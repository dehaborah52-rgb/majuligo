# ==============================================================================
# MajuliGo Platform Environment Configuration Template
# COPY this file to .env in respective app folders or root for local development.
# NEVER commit raw .env files containing production secrets.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_BASE_URL=http://localhost:4000

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Database & Supabase (PostgreSQL + PostGIS)
# For local development with Docker: postgresql://postgres:postgres@localhost:5432/majuligo
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/majuligo
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT & Authentication Secrets
JWT_SECRET=super-secret-at-least-32-chars-long-development-key-12345
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super-secret-refresh-key-32-chars-development-67890
REFRESH_TOKEN_EXPIRES_IN=30d

# SMS / OTP Provider (MSG91 / Fast2SMS / Twilio)
# Set to 'mock' for local development (default OTP: 123456)
OTP_PROVIDER=mock
OTP_DEFAULT_DEV_CODE=123456
SMS_API_KEY=

# Maps & Routing (OSRM & OpenStreetMap free by default)
OSRM_ROUTING_URL=https://router.project-osrm.org
NOMINATIM_GEOCODING_URL=https://nominatim.openstreetmap.org

# Payment Gateway (Razorpay India test keys)
RAZORPAY_KEY_ID=rzp_test_samplekey1234
RAZORPAY_KEY_SECRET=sample_secret_5678
UPI_VPA_MERCHANT=majuligo@upi
UPI_MERCHANT_NAME=MajuliGo

# Push Notifications (Expo / FCM)
EXPO_ACCESS_TOKEN=

# Admin Panel
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
